# Copy to api/.env and adjust. Never commit api/.env.

# Database (matches docker-compose service "db").
# DATABASE_URL: owner/superuser — used by Alembic migrations only.
DATABASE_URL=postgresql+asyncpg://receipt:receipt@db:5432/receipt
# APP_DATABASE_URL: restricted, RLS-bound role used by the running app.
# (Superusers bypass RLS, so runtime must NOT use the owner role.)
APP_DATABASE_URL=postgresql+asyncpg://receipt_app:receipt_app@db:5432/receipt

# Secrets — generate strong random values for production.
SESSION_SECRET=change-me-session-secret
# 32-byte urlsafe base64 key used to encrypt per-firm AI keys (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key

# Object storage (MinIO / S3-compatible).
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=receipts
S3_REGION=us-east-1

# Self-hosted AI hosts (on the VM host). Used when a firm selects ollama/whisper.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_TEXT_MODEL=qwen2.5:14b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
WHISPER_HOST=http://host.docker.internal:9100

# CORS for local web dev (Vite). Prod is single-origin so this can be empty.
CORS_ORIGINS=http://localhost:5173

# Cookie/session.
COOKIE_SECURE=false
