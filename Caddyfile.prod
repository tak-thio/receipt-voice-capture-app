# Production host with a SPLIT between tenant traffic and the operator (運営) surface.
#
#   :443   receipt.billpo.jp          -> tenant SPA + tenant API. Operator routes BLOCKED (404).
#   :8443  receipt.billpo.jp:8443     -> operator console + operator API ONLY.
#
# The operator surface ("全体を触る" API) is moved to a dedicated port so it can be
# locked down by the firewall (IP allowlist) independently of normal tenant use.
# Caddy reuses the receipt.billpo.jp certificate for the :8443 site automatically.
{
	email kawano@itsherpa.com
	# Coraza must run before reverse_proxy / file_server.
	order coraza_waf first
}

# OWASP CRS (Coraza) — shared by both sites. Rules mounted at /etc/caddy/coraza.
(waf) {
	coraza_waf {
		directives `
		Include /etc/caddy/coraza/coraza.conf
		Include /etc/caddy/coraza/crs/crs-setup.conf
		Include /etc/caddy/coraza/crs/rules/*.conf
		SecRuleEngine On
		`
	}
}

# ---- Public tenant site (:443) -------------------------------------------
receipt.billpo.jp {
	import waf
	route {
		# Operator surface is NOT public — served only on the IP-restricted :8443.
		@operator path /operator* /api/operator/*
		respond @operator 404

		# Tenant API under /api/* -> FastAPI (strip the /api prefix).
		handle_path /api/* {
			reverse_proxy api:8000
		}

		# Tenant SPA, with history fallback for client routing.
		handle {
			root * /srv
			try_files {path} /index.html
			file_server
		}
	}
}

# ---- Operator console site (:8443, firewall IP-allowlisted) ---------------
receipt.billpo.jp:8443 {
	import waf
	route {
		# Operator API only: /api/operator/* -> FastAPI (strip /api). Other /api -> 404.
		handle_path /api/* {
			route {
				@op path /operator/*
				reverse_proxy @op api:8000
				respond 404
			}
		}

		# Operator console + shared assets — real static files, NO SPA fallback.
		@assets path /operator.html /assets/*
		handle @assets {
			root * /srv
			file_server
		}

		# Nothing else is exposed on this port.
		respond 404
	}
}
