# Root ignores shared by all packages. App-specific ignores live in
# mobile/.gitignore and api/.gitignore.

# OS / editors
.DS_Store
tmp

# Node (any package: mobile/, web/)
node_modules
dist

# Python (any package: api/)
__pycache__
*.pyc
.venv
.pytest_cache
.mypy_cache
.ruff_cache

# Vite cache
.vite
*.tsbuildinfo

# Fetched OWASP CRS / coraza rules (populated by caddy/fetch-crs.sh at deploy)
/coraza/

# Secrets — never commit
.env
client_secret_*.json
*.apps.googleusercontent.com.json
