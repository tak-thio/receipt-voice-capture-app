# Tauri / Rust build outputs (keep the generated gen/ sources, ignore artifacts).
src-tauri/target
src-tauri/gen/android/.gradle
src-tauri/gen/android/build
src-tauri/gen/android/app/build
src-tauri/gen/android/app/.cxx
src-tauri/gen/android/local.properties
src-tauri/gen/android/app/src/main/jniLibs
src-tauri/gen/apple/build
src-tauri/gen/apple/Pods
src-tauri/gen/apple/Externals
src-tauri/gen/apple/*.xcworkspace/xcuserdata
src-tauri/gen/apple/*.xcodeproj/xcuserdata
src-tauri/gen/apple/*.xcodeproj/project.xcworkspace/xcuserdata
src-tauri/ios/.build
src-tauri/ios/.tauri
src-tauri/.tauri

# Android 署名鍵・パスワード(絶対にコミットしない。鍵本体はリポジトリ外に保管)
src-tauri/gen/android/keystore.properties
*.jks
*.keystore

# Local app data / secrets / STT sidecar (never commit)
receipt-sessions
src-tauri/receipt-sessions
settings.json
src-tauri/settings.json
.venv-stt
# 物体検出モデル(差し替え可能・サイズ大。各自 public/models/ に配置)
public/models/
scripts/dev-tauri-gemini.sh
*.command
